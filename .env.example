# Inbox Helper Configuration

# Application Environment (development, testing, production)
INBOX_HELPER_ENV=development

# SQLite Persistence Path
INBOX_HELPER_DB_PATH=data/inbox_helper.db

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
INBOX_HELPER_LOG_LEVEL=INFO

# Supported providers: mock or ollama. OpenAI and Gemini are not implemented.
INBOX_HELPER_LLM_PROVIDER=mock

# Explicit local workflow demonstration; outputs are predefined mock responses.
INBOX_HELPER_DEMO_MODE=false

# Model used by Ollama; change it to a model available in your local Ollama.
INBOX_HELPER_LLM_MODEL=llama3.2
INBOX_HELPER_LLM_TIMEOUT=30.0
# Must be finite and between 0 and 300 seconds.
INBOX_HELPER_LLM_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434

# To use Ollama: set provider=ollama, demo mode=false, then run
# `ollama serve` and `ollama pull llama3.2`.
# To use deterministic AI-shaped fixtures instead, set demo mode=true with
# provider=mock. Demo outputs are predefined, not AI-generated.

# External provider credentials (reserved; never commit actual keys)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
