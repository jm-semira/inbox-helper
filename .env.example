# Inbox Helper Configuration

# Application Environment (development, testing, production)
INBOX_HELPER_ENV=development

# SQLite Persistence Path
INBOX_HELPER_DB_PATH=data/inbox_helper.db

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
INBOX_HELPER_LOG_LEVEL=INFO

# LLM Provider Selection (mock, ollama, openai, gemini)
# For Day 1, 'mock' is available and functional without external API credentials.
INBOX_HELPER_LLM_PROVIDER=mock

# LLM Provider Configuration
INBOX_HELPER_LLM_MODEL=mock-model-v1
INBOX_HELPER_LLM_TIMEOUT=30.0
INBOX_HELPER_LLM_TEMPERATURE=0.2

# External Provider Credentials (reserved for Day 2+; never commit actual keys)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
